# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=9500

# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:manager@localhost:5432/ubuntu_web_os

# Administrative Credentials
OS_WEBOS_USER=admin
OS_WEBOS_PASS=change-me
OS_WEBOS_SESSION_SECRET=change-me

# Security Restrictions
OS_WEBOS_RATE_LIMIT_MAX=300
OS_WEBOS_RATE_LIMIT_WINDOW_SEC=60

# Request Limits (Bytes)
OS_WEBOS_MAX_REQUEST_BYTES=65536
OS_WEBOS_MAX_JSON_BYTES=65536

# Output Limits (Bytes)
OS_WEBOS_MAX_STDOUT_BYTES=32768
OS_WEBOS_MAX_STDERR_BYTES=16384

# Feature flags & Integrations
AWS_REGION=us-east-1
LIAE_ENABLED=true
WAZUH_ENABLED=false
DOCKER_ENABLED=true
KUBERNETES_ENABLED=false
